import React from "react";
import {useState} from "react";


const App = () => {

var[str,setStr] = useState("");
var[count,setCount] = useState(0);
var[start,setStart] = useState(null);
let Timer;


const getIncreamented = (cb,t) => {

return function(...args){

if(Timer) clearInterval(Timer);

Timer = setInterval(() => {

cb(args);

},t)

}

}


const getCountIncreamented = getIncreamented(() => {

if(count === 1){

clearInterval(Timer);
setStart(null);

}

setCount(--count);




},1000)


const getStarted = () => {

if(count === 0) return; // If the Field is empty It Does not Do any Action Just Return Without doing any Further Action.


setStart("start");
getCountIncreamented();


}


return(


<>

<input type = "number" id = "txtId" name = "txtName" className = "txtCls" onChange = {(e) => setCount(e.target.value)}></input>
<input type = "button" id = "btnId" name = "btnName" value = {start === null ? 'Start' : 'Stop'} onClick = {() => getStarted()}></input>
<div><span>{count}</span>&nbsp;&nbsp;<span 
style = {{
  
  color : start !== null ? 'green' : 'red',
  backgroundColor : 'black'

}}

>{start !== null ? 'Time Started...' : 'Time Over...'}</span></div>


</>



)





}


export default App;

