// ProfileSlice.jsx


import { createSlice } from "@reduxjs/toolkit";


const initialState = [];
const ProSlice = createSlice({

    name: 'profileSlicer',
    initialState,
    reducers: {


        myFunc(state, action) {

            state.push(action.payload);

        },

        myDel(state, action) {

            const delId = action.payload;

            return state.filter((lst) => lst.id !== delId)

        },

        myUpdate(state, action) {

            state = state.map(u => {

                if (u.id === action.payload.id) {


                    u.id = action.payload.id;
                    u.name = action.payload.name;
                    u.date = action.payload.date;
                    u.place = action.payload.place;
                    u.gender = action.payload.gender;




                }

                return u;

            })

        }


    }


});


export const { myFunc, myDel, myUpdate } = ProSlice.actions;
export default ProSlice.reducer;


