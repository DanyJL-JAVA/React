import  { useState } from 'react';
import { useSelector } from 'react-redux';
import { useEffect } from 'react';
import { useDispatch } from 'react-redux';
import { myDel } from '../Slice/ProfileSlice';
import { myUpdate } from '../Slice/ProfileSlice';



const ProfileView = () => {


    const sella = useSelector((sell) => sell.storeData);

    useEffect(() => {

        setArrlst(sella);

    }, [sella]);

    const [arrlst, setArrlst] = useState([]);
    const [editable, setEditable] = useState(false);
    const [editId, setEditId] = useState("");

    const [eName, setEName] = useState("");
    const [eDate, setEDate] = useState("");
    const [ePlace, setEPlace] = useState("");
    const [eGender, setEGender] = useState("");

    // Delete

    const Dispatch = useDispatch();

    const DeleteandSort = (Id) => {

        Dispatch(myDel(Id));


    }

    // Delete


    // Edit

    const edit = (Id) => {

        setEditable(true);
        setEditId(Id);

    }

    // Edit



    return (
        <div>


            <h5>ProfileView</h5>

            <table>

                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>location</th>
                    <th>Gender</th>
                    <th>status</th>
                </tr>


                {arrlst.map((abc) =>




                    <tr>
                        <td>{editable === true && editId === abc.id ? <input type="text" placeholder={abc.name} defaultValue={abc.name}
                            onChange={(event) => {


                                setEName(event.target.value === '' ? abc.name : event.target.value);


                            }} ></input> : <span>{abc.name}</span>}</td>
                        <td>{editable === true && editId === abc.id ? <input type="date" placeholder={abc.date} defaultValue={abc.date}
                            onChange={(event) => {

                                setEDate(event.target.value === '' ? abc.date : event.target.value);

                            }}></input> : <span>{abc.date}</span>}</td>
                        <td>{editable === true && editId === abc.id ? <input type="text" placeholder={abc.place} defaultValue={abc.place}
                            onChange={(event) => {

                                setEPlace(event.target.value === '' ? abc.place : event.target.value);

                            }}></input> : <span>{abc.place}</span>}</td>
                        <td>{editable === true && editId === abc.id ? <input type="text" placeholder={abc.gender} defaultValue={abc.gender}
                            onChange={(event) => {

                                setEGender(event.target.value === "" ? abc.gender : event.target.value);

                            }}></input> : <span>{abc.gender}</span>}</td>


                        <td>

                            {editable === true && editId ===

                                abc.id ? (
                                <>
                                    <input type="button" value="Add" onClick={() => {


                                        Dispatch(myUpdate({
                                            id: abc.id,
                                            name: eName === '' ? abc.name : eName,
                                            date: eDate === '' ? abc.date : eDate,
                                            place: ePlace === '' ? abc.place : ePlace,
                                            gender: eGender === '' ? abc.gender : eGender
                                        }));

                                        setEditable(false);

                                        //
                                        setEName('');
                                        setEDate('');
                                        setEPlace('');
                                        setEGender('');



                                    }}></input>
                                    <input type="button" value="cancel" onClick={() => setEditable(false)}></input>
                                </>
                            )
                                : (

                                    <>
                                        <input type="button" id="editId" name="editName" className="editClass" value="Edit" onClick={() => edit(abc.id)}></input>
                                        <input type="button" id="delId" name="delName" className="delClass" value="Delete" onClick={() => DeleteandSort(abc.id)}></input>
                                    </>

                                )}

                        </td>


                    </tr>



                )}



            </table>



        </div>



    )
}

export default ProfileView;


