// ProfileCreate.jsx



import { useState } from "react";
import { myFunc } from "../Slice/ProfileSlice";
import { useDispatch } from "react-redux";
import ProfileList from "./ProfileList";
import { createContext } from "react";


export const LoginContext = createContext();

const ProfileCreate = () => {



    const [str, setStr] = useState("");
    const [dat, setDat] = useState("");
    const [loc, setLoc] = useState("");
    const [gen, setGen] = useState("");



    const Dispatch = useDispatch();

    const lst = {

        id: Date.now(),
        name: str,
        date: dat,
        place: loc,
        gender: gen
    }

    const Location = [
        {
            id: 'Ch',
            place: 'Chennai'
        },
        {
            id: 'Md',
            place: 'madurai'
        },
        {
            id: 'my',
            place: 'mysore'
        },
        {
            id: 'Pn',
            place: 'Pune'
        }

    ]

    return (

        <div className="CreateClass">

            <h5>Form</h5>

            <fieldset>

                <legend>Application</legend>

                <label>Name : </label>
                <input type="text" id="empId" className="empClass" onChange={(event) => setStr(event.target.value)}></input>
                <br /><br />
                <label>Date</label>
                <input type="date" id="dtId" name="dtName" className="dtClass" onChange={(event) => setDat(event.target.value)}></input>
                <br /><br /><br />
                <label>Please Select the Prefered Location</label>
                <select id="selectId" onClick={(event) => setLoc(event.target.value)}>

                    {Location.map(abc =>

                        <option key={abc.id}>{abc.place}</option>

                    )}

                </select>
                <br></br><br></br>
                <label>Gender:</label>&nbsp;&nbsp;
                {/* &nbsp; used for making space  */}
                <span>Male</span>
                <input type="radio" id="maleId" name="maleName" className="maleClass" onClick={(event) => {

                    setGen(gen === true ? 'Female' : 'Male');

                    var fem = document.getElementById("femaleId").checked;

                    if (fem) {

                        document.getElementById("femaleId").checked = false;

                    }



                }}></input>
                <span>Female</span>
                <input type="radio" id="femaleId" name="femaleName" className="femaleClas" onClick={(event) => {

                    setGen(gen === true ? 'Male' : 'Female');


                    var ma = document.getElementById("maleId").checked;

                    if (ma) {

                        document.getElementById("maleId").checked = false;
                        // document.getElementById("femaleId").checked = false;

                    }


                }}></input>

                <br /><br /><br />

                <input type="button" id="saveId" name="btnName" className="saveClass" value="Save"
                    onClick={() => {


                        Dispatch(myFunc(lst));

                        document.getElementById("empId").value = '';
                        document.getElementById("dtId").value = '';
                        document.getElementById("maleId").checked = false;
                        document.getElementById("femaleId").checked = false;
                        document.getElementById("selectId").value = '';

                    }}></input>

            </fieldset>

            <LoginContext.Provider value={str}>
                <ProfileList />
            </LoginContext.Provider>



        </div>


    )



}



export default ProfileCreate;



